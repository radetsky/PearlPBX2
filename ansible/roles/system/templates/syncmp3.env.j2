# syncmp3 configuration

# Destination for MP3 backups (required).
# Example: /mnt/iscsci/evakuator/monitor
BACKUP_DIR=

# Source directory with Asterisk recordings (default is usually fine)
MONITOR_DIR=/var/spool/asterisk/monitor

# Local retention — how long to keep files on this server after they are backed up
LOCAL_MP3_DAYS=5
LOCAL_WAV_DAYS=1

# Backup retention — how long to keep files in BACKUP_DIR
BACKUP_MP3_DAYS=30

# Slack alerts on failure (optional).
# To get a webhook URL:
#   1. Go to https://api.slack.com/apps → Create New App → Incoming Webhooks
#   2. Add a webhook, pick a channel, copy the URL
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts-server
