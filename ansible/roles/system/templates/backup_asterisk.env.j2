# backup_asterisk configuration

# Destination for /etc/asterisk backups (required).
BACKUP_DIR=/var/backups/asterisk-etc

# Source directory to back up (default is usually fine)
SOURCE_DIR=/etc/asterisk

# Retention — how many days to keep backup archives in BACKUP_DIR
RETENTION_DAYS=14

# Slack alerts on failure (optional).
# To get a webhook URL:
#   1. Go to https://api.slack.com/apps → Create New App → Incoming Webhooks
#   2. Add a webhook, pick a channel, copy the URL
SLACK_WEBHOOK_URL=
