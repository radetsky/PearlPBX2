# pg_backup_asterisk configuration

# PostgreSQL user for pg_dump (default is usually fine)
DB_USER=asterisk

# Destination directory for backup files
BACKUP_DIR=/var/backups/postgresql/asterisk

# How many days to keep backup files
RETENTION_DAYS=30

# Slack alerts on failure (optional).
# To get a webhook URL:
#   1. Go to https://api.slack.com/apps → Create New App → Incoming Webhooks
#   2. Add a webhook, pick a channel, copy the URL
SLACK_WEBHOOK_URL=
