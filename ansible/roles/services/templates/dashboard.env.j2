AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=dashboard_listener
AMI_PASS={{ pearlpbx2_ami_dashboard_pass }}
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
LOGLEVEL=20

# Slack notifications for missed queue calls (optional).
# Leave SLACK_MISSED_CALL_WEBHOOK_URL empty to disable.
SLACK_MISSED_CALL_WEBHOOK_URL={{ pearlpbx2_slack_missed_call_webhook_url | default('') }}
SLACK_TIMEOUT=4
SLACK_USERNAME=PearlPBX2
MISSED_CALL_DEBOUNCE_SECONDS={{ pearlpbx2_missed_call_debounce_seconds | default(60) }}
