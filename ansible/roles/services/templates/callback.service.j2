[Unit]
Description=Callback Service for PearlPBX2
After=network.target postgresql.service asterisk.service
Wants=asterisk.service
Requires=postgresql.service

[Service]
Type=simple
User={{ pearlpbx2_user }}
Group={{ pearlpbx2_group }}
WorkingDirectory={{ pearlpbx2_install_dir }}/services/callback
Environment="PATH={{ pearlpbx2_install_dir }}/services/callback/.python-venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile={{ pearlpbx2_etc_dir }}/callback/env
ExecStart={{ pearlpbx2_install_dir }}/services/callback/.python-venv/bin/python {{ pearlpbx2_install_dir }}/services/callback/callback.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pearlpbx-callback
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
