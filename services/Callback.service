[Unit]
Description=Callback Service for PearlPBX2
After=network.target postgresql.service asterisk.service
Wants=asterisk.service
Requires=postgresql.service

[Service]
Type=simple
User=asterisk
Group=asterisk
WorkingDirectory=/usr/local/PearlPBX2/services/callback
Environment="PATH=/usr/local/PearlPBX2/services/callback/.python-venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/usr/local/PearlPBX2/services/callback/.env
ExecStart=/usr/local/PearlPBX2/services/callback/.python-venv/bin/python /usr/local/PearlPBX2/services/callback/callback.py
Restart=on-failure
RestartSec=5

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pearlpbx-callback

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
