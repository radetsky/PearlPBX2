[Unit]
Description=Express FastAGI Service for PearlPBX2
After=network.target asterisk.service
Wants=asterisk.service

[Service]
Type=simple
User=asterisk
Group=asterisk
WorkingDirectory=/usr/local/PearlPBX2/services/express
Environment="PATH=/usr/local/PearlPBX2/services/express/.python-venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/usr/local/PearlPBX2/services/express/env
ExecStart=/usr/local/PearlPBX2/services/express/.python-venv/bin/python /usr/local/PearlPBX2/services/express/express_fastagi.py
Restart=on-failure
RestartSec=5

# Logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pearlpbx-express

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
