export ALLOWED_HOSTS=127.0.0.1
export CSRF_TRUSTED_ORIGINS="http://asterisk2025,http://127.0.0.1:8000,http://localhost"
export ASTERISK_ROOT_DIR="/tmp"
export ASTERISK_CONFIG_DIR="/etc/asterisk"
export ASTERISK_BACKUP_DIR="/tmp/backup/asterisk"

export ASTERISK_MANAGER_PORT=5038
export ASTERISK_MANAGER_HOST=127.0.0.1
export ASTERISK_MANAGER_USERNAME=PearlPBX2
# Required in Production/Staging. Generate a unique one per install:
#   openssl rand -base64 48
export ASTERISK_MANAGER_SECRET=""


# Production, Staging, Development, without_asterisk_on_localhost
export DEVMODE="Production"
export DEBUG=False

export DJANGO_SECRET_KEY=""
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

export DB_NAME="pearlpbx2"
export DB_USER="pearlpbx2"
export DB_PASS="your_password"
export DB_HOST="localhost"
export DB_PORT=5432

export REDIS_URL="redis://localhost:6379"

# Public base URL of the web interface (used in CRM webhook payloads
# to build call recording links)
# export PEARLPBX_PUBLIC_URL="https://pbx.example.com"

export TFTP_DIR="/var/lib/tftpboot"

# Optional: fallback directory for call recordings (e.g. iSCSI mount)
# export ASTERISK_BACKUP_MONITOR_DIR="/mnt/iscsi/evakuator/monitor"

# Phone number normalization (defaults: Ukraine)
# export PHONE_COUNTRY_CODE="380"
# export PHONE_LOCAL_CODE="044"
# export PHONE_REQUIRED_LEN=10
# export PHONE_CITYCODE_LEN=7
